server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS interne de Docker : l'adresse du backend est résolue à chaque requête,
    # ce qui permet à nginx de démarrer même si le backend n'est pas encore lancé
    resolver 127.0.0.11 valid=10s;

    # Les appels à l'API sont relayés vers le backend (BACKEND_URL est remplacé au démarrage du conteneur)
    location /api/ {
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
