# Les variables ${...} sont remplacées par leur valeur au démarrage du conteneur
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS du conteneur : l'adresse du backend est résolue à chaque requête,
    # ce qui permet à nginx de démarrer même si le backend n'est pas encore lancé
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Les appels à l'API sont relayés vers le backend
    location /api/ {
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        # Nécessaire quand le backend est joint en HTTPS derrière un nom de domaine partagé
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
